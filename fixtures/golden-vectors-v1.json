  "slotMapping": {
    "specification": "specs/rng-fairness.md §4 — cumulative lookup in slot_index order",
    "note": "cum_0 = p_0, cum_i = cum_{i-1} + p_i, and v yields slot i where cum_{i-1} <= v < cum_i (cum_{-1} = 0). The comparison is STRICTLY less-than: a v equal to a cumulative bound belongs to the NEXT slot, and a slot with probabilityPpm 0 can never be selected.",
    "canonicalOrder": "The lookup runs in ASCENDING slotIndex order. slotsAsGiven below is deliberately NOT ascending: caller order is never trusted, exactly as the 0x01 edition preimage sorts before hashing. An implementation that walks the published array as-is disagrees.",
    "vectors": [
      {
        "id": "boundary-v-equals-cum0",
        "note": "v is EXACTLY cum_0 (186669). Strictly-less-than puts it in slot 1; an implementation using <= returns slot 0. The single most likely §4 defect.",
        "clientSeed": "alice-seed",
        "nonce": 1,
        "v": 186669,
        "slotsAsGiven": [
          {
            "slotIndex": 2,
            "probabilityPpm": 500000
          },
          {
            "slotIndex": 0,
            "probabilityPpm": 186669
          },
          {
            "slotIndex": 1,
            "probabilityPpm": 313331
          }
        ],
        "slotIndex": 1
      },
      {
        "id": "boundary-v-below-cum0",
        "note": "The other side of the same edge: the identical v (186669) against cum_0 = 186670 lands in slot 0. Paired with the case above, the bound is pinned from both directions.",
        "clientSeed": "alice-seed",
        "nonce": 1,
        "v": 186669,
        "slotsAsGiven": [
          {
            "slotIndex": 1,
            "probabilityPpm": 313330
          },
          {
            "slotIndex": 2,
            "probabilityPpm": 500000
          },
          {
            "slotIndex": 0,
            "probabilityPpm": 186670
          }
        ],
        "slotIndex": 0
      },
      {
        "id": "falls-through-to-last-slot",
        "note": "v = 459796 clears both leading bounds and resolves on the final slot, so the loop is exercised to its last iteration rather than returning early every time.",
        "clientSeed": "alice-seed",
        "nonce": 2,
        "v": 459796,
        "slotsAsGiven": [
          {
            "slotIndex": 2,
            "probabilityPpm": 813330
          },
          {
            "slotIndex": 1,
            "probabilityPpm": 1
          },
          {
            "slotIndex": 0,
            "probabilityPpm": 186669
          }
        ],
        "slotIndex": 2
      },
      {
        "id": "zero-ppm-slot-is-skipped",
        "note": "Slot 0 carries probabilityPpm 0, so the cumulative total does not advance and no v can ever select it. An implementation using <= returns slot 0 for every draw here.",
        "clientSeed": "alice-seed",
        "nonce": 3,
        "v": 261902,
        "slotsAsGiven": [
          {
            "slotIndex": 1,
            "probabilityPpm": 1000000
          },
          {
            "slotIndex": 0,
            "probabilityPpm": 0
          }
        ],
        "slotIndex": 1
      },
      {
        "id": "single-slot-full-ppm",
        "note": "The degenerate table: one slot holding the whole million. Every v resolves to slot 0, and an implementation that mishandles a one-element table fails here.",
        "clientSeed": "alice-seed",
        "nonce": 1,
        "v": 186669,
        "slotsAsGiven": [
          {
            "slotIndex": 0,
            "probabilityPpm": 1000000
          }
        ],
        "slotIndex": 0
      }
    ]
  },

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "module": "ES2022",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/browser.spec.ts"]
}
